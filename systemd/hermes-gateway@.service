[Unit]
Description=Hermes Gateway - Profile %i
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
ExecStart=/opt/hermes/venv/bin/python \
  -m hermes_cli.main gateway run --replace
WorkingDirectory=/home/%i/.hermes
Environment="HERMES_HOME=/home/%i/.hermes"
Environment="PATH=/opt/hermes/venv/bin:/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin"
Environment="VIRTUAL_ENV=/opt/hermes/venv"
Restart=on-failure
RestartSec=5
RestartMaxDelaySec=60
RestartSteps=3
KillMode=mixed
KillSignal=SIGTERM
TimeoutStopSec=90
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target