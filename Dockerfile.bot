FROM python:3.11-slim

# 安装系统依赖（curl+Node.js 避免 Hermes 启动时阻塞安装 + websockets 是 Hermes 必需依赖）
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && pip install --no-cache-dir hermes-agent aiohttp cryptography websockets \
    && rm -rf /var/lib/apt/lists/*

# 默认时区
ENV TZ=Asia/Shanghai

# 创建运行用户
RUN useradd -m --uid 1000 hermes
USER hermes
WORKDIR /home/hermes

# 默认 CMD（启动 Hermes Gateway）
CMD ["hermes", "gateway", "run", "--replace"]
