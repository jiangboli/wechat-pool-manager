FROM python:3.11-slim

# 安装系统依赖（curl+Node.js 避免 Hermes 启动时阻塞安装 + websockets 是 Hermes 必需依赖）
RUN apt-get update && apt-get install -y --no-install-recommends \
    tzdata curl ca-certificates gnupg \
    && mkdir -p /etc/apt/keyrings \
    && curl -fsSL https://deb.nodesource.com/setup_22.x | bash - \
    && apt-get install -y --no-install-recommends nodejs \
    && pip install --no-cache-dir hermes-agent aiohttp cryptography websockets \
    && rm -rf /var/lib/apt/lists/*

# 默认时区
ENV TZ=Asia/Shanghai

# 创建运行用户
RUN useradd -m --uid 1000 hermes
USER hermes
WORKDIR /home/hermes

# 写入预置 AGENTS.md——长任务进度报告规则
RUN echo '# 长任务进度报告

当执行耗时的操作（网页搜索、数据分析、文件处理等）时：

1. 如果任务开始后 1 分钟仍未回复用户，必须发送进度更新
2. 之后每隔 1 分钟更新一次进度，直到任务完成
3. 进度消息格式：
   - 已用时
   - 当前进度（步骤 N/M）
   - 关键输出摘要

4. 任务完成后发送最终结果（成功/失败）
5. 用户回复消息后停止进度报告' > /home/hermes/AGENTS.md

# 默认 CMD（启动 Hermes Gateway）
COPY start-hermes.py /app/start-hermes.py

CMD ["python", "/app/start-hermes.py"]
